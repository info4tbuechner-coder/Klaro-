rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Primitive Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Validation Blueprint for User Profile
    function isValidUser(data) {
      return data.keys().hasAll(['userId', 'email', 'createdAt', 'updatedAt']) &&
        data.userId is string && data.userId == request.auth.uid &&
        data.email is string && data.email.size() <= 256 &&
        (!data.keys().hasAny(['displayName']) || (data.displayName is string && data.displayName.size() <= 100)) &&
        data.createdAt is number &&
        data.updatedAt is number;
    }

    // Validation Blueprint for Transaction
    function isValidTransaction(data) {
      return data.keys().hasAll(['id', 'userId', 'type', 'amount', 'description', 'date', 'createdAt', 'updatedAt']) &&
        data.id is string && data.id.size() <= 128 &&
        data.userId is string && data.userId == request.auth.uid &&
        data.type is string && (data.type == 'income' || data.type == 'expense' || data.type == 'saving') &&
        data.amount is number &&
        data.description is string && data.description.size() <= 1000 &&
        data.date is string && data.date.size() <= 50 &&
        (!data.keys().hasAny(['categoryId']) || (data.categoryId is string && data.categoryId.size() <= 100)) &&
        (!data.keys().hasAny(['category']) || (data.category is string && data.category.size() <= 100)) &&
        (!data.keys().hasAny(['goalId']) || (data.goalId is string && data.goalId.size() <= 100)) &&
        (!data.keys().hasAny(['tags']) || (data.tags is list && data.tags.size() <= 20)) &&
        (!data.keys().hasAny(['liabilityId']) || (data.liabilityId is string && data.liabilityId.size() <= 100)) &&
        (!data.keys().hasAny(['merchant']) || (data.merchant is string && data.merchant.size() <= 200)) &&
        (!data.keys().hasAny(['receiptUrl']) || (data.receiptUrl is string && data.receiptUrl.size() <= 2000)) &&
        data.createdAt is number &&
        data.updatedAt is number;
    }

    // Users Collection
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) &&
        isValidId(userId) &&
        isValidUser(incoming());
      allow update: if isOwner(userId) &&
        isValidUser(incoming()) &&
        incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'email', 'updatedAt']);
      allow delete: if isOwner(userId);

      // Transactions Subcollection
      match /transactions/{transactionId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) &&
          isValidId(transactionId) &&
          isValidTransaction(incoming());
        allow update: if isOwner(userId) &&
          isValidTransaction(incoming()) &&
          incoming().diff(existing()).affectedKeys().hasOnly(['type', 'amount', 'description', 'date', 'categoryId', 'category', 'goalId', 'tags', 'liabilityId', 'merchant', 'receiptUrl', 'updatedAt']);
        allow delete: if isOwner(userId);
      }
    }
  }
}
